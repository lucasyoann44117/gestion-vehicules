<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vehicules.Core\Vehicules.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\src\Vehicules.Web\wwwroot\diagnostic\t4-acv.json" Link="t4-acv.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Vehicules.Web\wwwroot\diagnostic\pieces-t4.json" Link="pieces-t4.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- L'historique réel sert de jeu d'essai s'il est présent (il reste hors du dépôt). -->
  <ItemGroup>
    <None Include="..\..\src\Vehicules.Web\wwwroot\donnees\historique.json" Link="historique.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\src\Vehicules.Web\wwwroot\donnees\historique.json')" />
  </ItemGroup>

</Project>
