@page "/pieces"
@inherits PageBase
@inject NavigationManager Nav

<Tete Titre="Pièces">
    <a class="btn" href="moteur"><svg aria-hidden="true"><use href="#i-pieces" /></svg>Sous le capot</a>
    <a class="btn" href="3d"><svg aria-hidden="true"><use href="#i-3d" /></svg>Vue 3D</a>
</Tete>

@{
    var etats = Etats().ToList();
    var changees = etats.Where(e => e.Etat.Changements.Count > 0).ToList();
    var aSurveiller = etats.Where(e => e.Etat.Urgence is Urgence.Bientot or Urgence.Depasse).ToList();
    var categories = etats.Select(e => e.Etat.Organe.Categorie).Distinct().OrderBy(c => c).ToList();
    var affichees = etats
        .Where(e => categorie is null || e.Etat.Organe.Categorie == categorie)
        .Where(e => tout || e.Etat.Changements.Count > 0)
        .Where(e => !urgentes || e.Etat.Urgence is Urgence.Bientot or Urgence.Depasse)
        .OrderByDescending(e => e.Etat.Urgence is Urgence.Depasse or Urgence.Bientot)
        .ThenByDescending(e => e.Etat.Avancement ?? -1)
        .ThenBy(e => e.Etat.Dernier?.Date ?? DateOnly.MaxValue)
        .ToList();
    var plusChere = etats.MaxBy(e => e.Cout);
}

<section class="stats">
    <button class="stat carte mise-en-avant lien-carte" @onclick="() => { tout = true; urgentes = false; categorie = null; }">
        <span>Pièces suivies</span>
        <strong>@etats.Count</strong>
        <small>@changees.Count déjà changées au moins une fois · tout voir ›</small>
    </button>
    <button class="stat carte lien-carte @(urgentes ? "active" : "")" @onclick="() => { urgentes = !urgentes; tout = true; }">
        <span>À surveiller</span>
        <strong>@aSurveiller.Count</strong>
        <small>@(aSurveiller.Count == 0 ? "Tout est dans les temps" : string.Join(", ", aSurveiller.Take(2).Select(e => e.Etat.Organe.Nom)))@(urgentes ? " · filtre actif ✕" : " ›")</small>
    </button>
    <a class="stat carte lien-carte" href="pieces/@(changees.MaxBy(e => e.Etat.Changements.Count)?.Etat.Organe.Id)">
        <span>La plus changée</span>
        @{ var plusChangee = changees.MaxBy(e => e.Etat.Changements.Count); }
        <strong>@(plusChangee?.Etat.Changements.Count ?? 0) fois</strong>
        <small>@plusChangee?.Etat.Organe.Nom ›</small>
    </a>
    <a class="stat carte lien-carte" href="pieces/@plusChere?.Etat.Organe.Id">
        <span>La plus coûteuse</span>
        <strong>@Euros(plusChere?.Cout ?? 0, 0)</strong>
        <small>@plusChere?.Etat.Organe.Nom ›</small>
    </a>
</section>

<div class="puces filtres-categories" role="group" aria-label="Système">
    <button class="puce @(categorie is null ? "active" : "")" @onclick="() => categorie = null">Tout</button>
    @foreach (var c in categories)
    {
        <button class="puce @(categorie == c ? "active" : "")" @onclick="() => categorie = c">@c</button>
    }
    <label class="case discret"><input type="checkbox" @bind="tout" /> Montrer les pièces jamais changées</label>
</div>

<section class="tableau-pieces">
    @foreach (var (etat, vehicule, cout) in affichees)
    {
        var d = etat.Dernier;
        <a class="tuile-piece @Classe(etat.Urgence)" href="pieces/@etat.Organe.Id" style="--accent:@vehicule.Couleur">
            <div class="tp-haut">
                <span class="tp-illu"><Illustration OrganeId="@etat.Organe.Id" /></span>
                <Anneau Valeur="etat.Avancement" Urgence="etat.Urgence" />
            </div>
            <span class="tp-cat">@etat.Organe.Categorie@(Etat.VehiculeId is null ? $" · {vehicule.Nom}" : "")</span>
            <strong class="tp-nom">@etat.Organe.Nom</strong>
            @if (d is not null)
            {
                <div class="tp-chiffres">
                    <div>
                        <b>@(etat.KmDepuis is { } k ? Nombre(k) : "–")</b>
                        <span>km depuis</span>
                    </div>
                    <div>
                        <b>@Mois(etat.MoisDepuis)</b>
                        <span>d'âge</span>
                    </div>
                </div>
                <small class="tp-pied">Changé le @Date(d.Date)@(d.Km is { } kc ? $" à {Km(kc)}" : "") · @etat.Changements.Count× · @Euros(cout, 0)</small>
            }
            else
            {
                <small class="tp-pied">Aucun changement enregistré</small>
            }
        </a>
    }
</section>

@code {
    private string? categorie;
    private bool tout, urgentes;

    private sealed record Ligne(EtatOrgane Etat, Vehicule Vehicule, decimal Cout);

    private IEnumerable<Ligne> Etats()
    {
        foreach (var v in Etat.Vehicules)
        {
            var inter = Etat.Donnees.Interventions.Where(i => i.VehiculeId == v.Id).ToList();
            var couts = Couts.ParOrgane(inter);
            foreach (var e in SuiviOrganes.Etats(Etat.Donnees.Organes.Where(o => o.VehiculeId == v.Id), inter, Etat.Releves(v.Id), Etat.Aujourdhui))
                yield return new Ligne(e, v, couts.GetValueOrDefault(e.Organe.Id));
        }
    }
}
