@page "/couts"
@inherits PageBase
@inject NavigationManager Nav

<Tete Titre="Coûts" />

@{
    var inter = Etat.Interventions.ToList();
    var releves = Etat.VehiculeId is { } vid ? Etat.Releves(vid) : [];
    var annees = Couts.ParAnnee(inter, releves, Etat.Aujourdhui);
    var max = annees.Count == 0 ? 0 : annees.Max(a => a.TotalTtc);
    var types = annees.SelectMany(a => a.ParType.Keys).Distinct().OrderBy(t => t).ToList();
    var total = inter.Sum(i => i.TotalTtc);
    var debut = inter.Count == 0 ? (DateOnly?)null : inter.Min(i => i.Date);
    var kmTotal = Etat.VehiculeId is not null && debut is { } d0 ? Kilometrage.Parcourus(releves, d0, Etat.Aujourdhui, Etat.Aujourdhui) : null;
}

@if (inter.Count == 0)
{
    <p class="vide">Aucune dépense enregistrée.</p>
}
else
{
    <section class="stats">
        <a class="stat carte mise-en-avant lien-carte" href="historique"><span>Total depuis le @Date(debut)</span><strong>@Euros(total, 0)</strong><small>@inter.Count interventions ›</small></a>
        <a class="stat carte lien-carte" href="historique?annee=@Etat.Aujourdhui.Year"><span>12 derniers mois</span><strong>@Euros(Couts.SurDouzeMois(inter, Etat.Aujourdhui), 0)</strong><small>Glissants · voir @Etat.Aujourdhui.Year ›</small></a>
        <a class="stat carte lien-carte" href="#par-annee"><span>Pièces / main-d'œuvre</span><strong>@Euros(inter.Sum(i => i.TotalPiecesHt), 0) / @Euros(inter.Sum(i => i.TotalMainOeuvreHt), 0)</strong><small>Montants HT · détail par année ›</small></a>
        <div class="stat carte">
            <span>Coût au km</span>
            <strong>@(kmTotal is > 0 ? Euros(total / kmTotal.Value, 3) : "–")</strong>
            <small>@(Etat.VehiculeId is null ? "Choisir un véhicule" : kmTotal is > 0 ? $"Sur {Km(kmTotal)}, hors carburant et assurance" : "Pas assez de relevés")</small>
        </div>
    </section>

    <section>
        <h2>Par année</h2>
        <div class="carte graphique">
        <div class="legende">
            @foreach (var t in types)
            {
                <a href="historique?type=@t"><i class="t-@t.ToString().ToLowerInvariant()"></i>@Libelle(t)</a>
            }
        </div>
        <div class="barres" role="img" aria-label="Dépenses par année">
            @foreach (var a in annees)
            {
                <a class="barre-annee" href="historique?annee=@a.Annee" style="--p:@Pourcent(a.TotalTtc, max)%" title="Voir les interventions de @a.Annee">
                    <span class="valeur">@Euros(a.TotalTtc, 0)</span>
                    <div class="pile">
                        @foreach (var t in types.Where(a.ParType.ContainsKey))
                        {
                            <i class="t-@t.ToString().ToLowerInvariant()" style="flex:@a.ParType[t].ToString(System.Globalization.CultureInfo.InvariantCulture)" title="@Libelle(t) : @Euros(a.ParType[t])"></i>
                        }
                    </div>
                    <span class="an">@a.Annee</span>
                </a>
            }
        </div>
        </div>
        <table class="tableau cliquable" id="par-annee">
            <thead>
                <tr><th>Année</th><th class="nb">TTC</th><th class="nb">Interventions</th><th class="nb">Pièces HT</th><th class="nb">Main-d'œuvre HT</th><th class="nb">Km parcourus</th><th class="nb">€ / km</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var a in annees.AsEnumerable().Reverse())
                {
                    <tr @onclick='() => Nav.NavigateTo($"historique?annee={a.Annee}")'>
                        <td data-label="Année"><strong>@a.Annee</strong></td>
                        <td data-label="TTC" class="nb">@Euros(a.TotalTtc)</td>
                        <td data-label="Interv." class="nb">@a.NombreInterventions</td>
                        <td data-label="Pièces HT" class="nb">@Euros(a.PiecesHt, 0)</td>
                        <td data-label="M.-O. HT" class="nb">@Euros(a.MainOeuvreHt, 0)</td>
                        <td data-label="Km" class="nb">@Km(a.KmParcourus)</td>
                        <td data-label="€ / km" class="nb">@(a.CoutParKm is { } c ? Euros(c, 3) : "–")</td>
                        <td class="chevron" aria-hidden="true">›</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Etat.VehiculeId is null && Etat.Donnees.Vehicules.Count > 1)
        {
            <p class="note">Les km et le coût au km s'affichent quand un seul véhicule est choisi.</p>
        }
    </section>

    <section>
        <h2>Ce qui coûte le plus</h2>
        @{
            var parOrgane = Couts.ParOrgane(inter).OrderByDescending(x => x.Value).Take(8).ToList();
            var maxOrgane = parOrgane.Count == 0 ? 0 : parOrgane[0].Value;
        }
        <ul class="classement carte">
            @foreach (var (id, montant) in parOrgane)
            {
                <li>
                    <a href="pieces/@id">@(Etat.Organe(id)?.Nom ?? id)</a>
                    <span class="jauge"><i style="width:@Pourcent(montant, maxOrgane)%"></i></span>
                    <strong>@Euros(montant, 0)</strong>
                </li>
            }
        </ul>
    </section>

    <section>
        <h2>Plus grosses factures</h2>
        <ul class="liste dernieres">
            @foreach (var i in inter.OrderByDescending(i => i.TotalTtc).Take(5))
            {
                <li>
                    <a class="ligne-lien" href="historique?id=@i.Id">
                        <div><strong>@i.Titre</strong><br /><small>@Date(i.Date) · @i.Garage</small></div>
                        <div class="droite"><strong>@Euros(i.TotalTtc)</strong></div>
                    </a>
                </li>
            }
        </ul>
    </section>
}

@code {
    private static string Pourcent(decimal v, decimal max) =>
        (max <= 0 ? 0 : Math.Round(v / max * 100, 1)).ToString(System.Globalization.CultureInfo.InvariantCulture);
}
