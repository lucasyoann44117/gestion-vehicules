@* Illustration d'une pièce, dessinée pour l'application (trait + aplat de la couleur du thème). *@
<svg class="illu @Classe" viewBox="0 0 64 64" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
    @switch (Famille(OrganeId))
    {
        case "huile":
            <path d="M14 26h24l8-6 6 2-10 10v16a4 4 0 0 1-4 4H14a4 4 0 0 1-4-4V30a4 4 0 0 1 4-4z" class="aplat" />
            <path d="M20 26v-5h10v5M52 22l4-3" />
            <path d="M24 44c0-4 4-8 4-8s4 4 4 8a4 4 0 0 1-8 0z" />
            break;
        case "filtre":
            <rect x="18" y="10" width="28" height="44" rx="6" class="aplat" />
            <path d="M18 20h28M18 44h28M24 20v24M30 20v24M36 20v24M42 20v24" />
            break;
        case "courroie":
            <circle cx="20" cy="42" r="10" class="aplat" />
            <circle cx="44" cy="20" r="8" class="aplat" />
            <circle cx="46" cy="46" r="5" />
            <path d="M12 36 38 13M28 49l14 2M51 44 52 24M30 40 40 27" />
            <circle cx="20" cy="42" r="3" /><circle cx="44" cy="20" r="2.5" />
            break;
        case "moteur":
            <path d="M12 24h8l4-6h14l4 6h8v6h4v12h-4v6H20l-4-6h-4z" class="aplat" />
            <path d="M24 18v-6h12v6M26 30h12M26 36h12M8 30v12" />
            break;
        case "turbo":
            <path d="M32 14a18 18 0 1 1-17.5 22H8V26h8" class="aplat" />
            <circle cx="32" cy="32" r="7" />
            <path d="M32 25c4 2 6 6 5 10M25 32c2-4 6-6 10-5M32 39c-4-2-6-6-5-10M39 32c-2 4-6 6-10 5" />
            break;
        case "batterie":
            <rect x="8" y="20" width="48" height="32" rx="4" class="aplat" />
            <path d="M16 20v-6h8v6M40 20v-6h8v6M16 34h8M44 30v8M40 34h8" />
            break;
        case "alternateur":
            <circle cx="32" cy="34" r="18" class="aplat" />
            <circle cx="32" cy="34" r="6" />
            <path d="M32 16v-6M20 22l-4-4M44 22l4-4M38 34l8 0M26 34h-8M32 40v8" />
            break;
        case "lumiere":
            <path d="M22 30a10 10 0 1 1 20 0c0 5-4 8-5 12H27c-1-4-5-7-5-12z" class="aplat" />
            <path d="M27 48h10M28 53h8M32 8v4M14 16l3 3M50 16l-3 3M10 30h4M50 30h4" />
            break;
        case "clim":
            <circle cx="32" cy="32" r="22" class="aplat" />
            <path d="M32 14v36M16 23l32 18M48 23 16 41M27 17l5 5 5-5M27 47l5-5 5 5" />
            break;
        case "frein":
            <circle cx="30" cy="34" r="20" class="aplat" />
            <circle cx="30" cy="34" r="6" />
            <path d="M40 14c10 4 14 12 14 20s-4 16-14 20" stroke-width="6" />
            <circle cx="30" cy="22" r="1.6" /><circle cx="40" cy="38" r="1.6" /><circle cx="20" cy="38" r="1.6" />
            break;
        case "pneu":
            <circle cx="32" cy="32" r="24" class="aplat" />
            <circle cx="32" cy="32" r="12" />
            <circle cx="32" cy="32" r="4" />
            <path d="M32 8v6M32 50v6M8 32h6M50 32h6M15 15l4 4M45 45l4 4M49 15l-4 4M15 49l4-4" />
            break;
        case "suspension":
            <rect x="26" y="8" width="12" height="20" rx="3" class="aplat" />
            <path d="M32 28v28M22 32l20 4M22 38l20 4M22 44l20 4M22 50l20 4M24 8h16" />
            break;
        case "transmission":
            <circle cx="24" cy="36" r="14" class="aplat" />
            <circle cx="24" cy="36" r="5" />
            <path d="M24 18v4M24 50v4M6 36h4M38 36h4M11 23l3 3M34 46l3 3M37 23l-3 3M11 49l3-3" />
            <path d="M38 22l18-12M44 26l12-8" />
            break;
        case "echappement":
            <path d="M8 22h18l6 6v8h12" />
            <rect x="34" y="28" width="22" height="16" rx="8" class="aplat" />
            <path d="M56 36h4M10 46c4-2 6 2 10 0M14 54c4-2 6 2 10 0" />
            break;
        case "eau":
            <path d="M32 8s16 18 16 30a16 16 0 0 1-32 0C16 26 32 8 32 8z" class="aplat" />
            <path d="M32 28v16M26 40h12" />
            break;
        case "essuie":
            <path d="M10 50 50 14" stroke-width="3" />
            <path d="M14 46 48 16" class="aplat" stroke-width="7" opacity=".35" />
            <circle cx="10" cy="50" r="4" />
            break;
        case "plaque":
            <rect x="6" y="22" width="52" height="20" rx="3" class="aplat" />
            <path d="M12 22v20M52 22v20M18 32h4M26 32h10M40 32h6" />
            break;
        case "chauffage":
            <path d="M32 8c6 8 14 14 14 26a14 14 0 0 1-28 0c0-6 3-10 6-13 0 6 3 9 6 9-2-8 0-15 2-22z" class="aplat" />
            break;
        default:
            <path d="M40 10a10 10 0 0 0-11 13L12 40a4 4 0 0 0 6 6l17-17a10 10 0 0 0 13-11l-6 6-5-1-1-5z" class="aplat" />
            break;
    }
</svg>

@code {
    [Parameter] public string? OrganeId { get; set; }
    [Parameter] public string? Classe { get; set; }

    /// <summary>Famille d'illustration d'après l'identifiant de la pièce (sans le préfixe du véhicule).</summary>
    public static string Famille(string? id)
    {
        var c = id ?? "";
        bool A(params string[] mots) => mots.Any(c.Contains);
        return true switch
        {
            _ when A("huile-boite", "commande-boite", "cardan", "soufflets", "embrayage") => "transmission",
            _ when A("huile") => "huile",
            _ when A("filtre") => "filtre",
            _ when A("distribution", "courroie", "pompe-eau") => "courroie",
            _ when A("turbo") => "turbo",
            _ when A("culasse", "joints-moteur") => "moteur",
            _ when A("batterie") => "batterie",
            _ when A("alternateur", "demarreur") => "alternateur",
            _ when A("eclairage", "faisceau", "bougies") => "lumiere",
            _ when A("clim") => "clim",
            _ when A("frein", "pompe-vide") => "frein",
            _ when A("pneu", "parallelisme") => "pneu",
            _ when A("rotule", "triangle", "biellettes", "direction", "amortisseur", "roulement") => "suspension",
            _ when A("echappement") => "echappement",
            _ when A("refroidissement") => "eau",
            _ when A("essuie") => "essuie",
            _ when A("plaque") => "plaque",
            _ when A("chauffage") => "chauffage",
            _ => "outil",
        };
    }
}
